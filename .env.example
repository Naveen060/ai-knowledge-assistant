# Map long random API tokens to server-controlled user IDs. Never expose this map to the frontend.
USER_TOKENS={"replace-with-a-long-random-alice-token":"alice","replace-with-a-long-random-bob-token":"bob"}
GENERATION_BACKEND=extractive
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STORE_PATH=data/knowledge.db
